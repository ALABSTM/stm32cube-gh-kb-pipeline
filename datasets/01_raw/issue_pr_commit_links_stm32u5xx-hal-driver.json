    "issue_number": 6,
    "issue_title": "header inclusion issues for STM32U545 series",
    "issue_labels": [
      "bug",
      "hal",
      "spotted before customer"
    ],
    "issue_state": "closed",
    "issue_url": "https://github.com/STMicroelectronics/stm32u5xx-hal-driver/issues/6",
    "linked_pr_numbers": [
      7
