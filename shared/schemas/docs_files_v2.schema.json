{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared/schemas/docs_files_v2.schema.json",
  "title": "STM32Cube docs_files_v2",
  "description": "Schema for data/docs_files_*_v2.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "source_kind",
      "repo",
      "mcu_package",
      "type",
      "path",
      "file_type",
      "ingest_version",
      "clean_text",
      "is_valid"
    ],
    "properties": {
      "id": { "type": "string" },
      "source_kind": { "type": "string", "const": "file" },
      "repo": { "type": "string" },
      "mcu_package": { "type": "string" },
      "mcu_series": { "type": ["string", "null"] },
      "type": { "type": "string", "const": "file" },
      "path": { "type": "string" },
      "file_type": {
        "type": "string",
        "enum": ["project_readme", "release_notes", "root_readme", "doc_readme", "driver_source", "other"]
      },
      "github_url": { "type": ["string", "null"] },
      "board": { "type": ["string", "null"] },
      "category": { "type": ["string", "null"] },
      "component": { "type": ["string", "null"] },
      "example_name": { "type": ["string", "null"] },
      "ingest_version": { "type": "string" },
      "clean_text": { "type": "string" },
      "is_valid": { "type": "boolean" }
    },
    "additionalProperties": true
  }
}
