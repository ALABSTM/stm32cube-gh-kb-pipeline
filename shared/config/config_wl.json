{
  "owner": "STMicroelectronics",
  "repos": [
    "STM32CubeWL",
    "stm32wlxx-hal-driver",
    "cmsis_device_wl",
    "stm32wlxx-nucleo-bsp",
    "b-wl5m-subg1-bsp"
