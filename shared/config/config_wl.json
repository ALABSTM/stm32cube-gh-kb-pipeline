    "cmsis_device_wl": "https://github.com/STMicroelectronics/cmsis_device_wl.git",
    "stm32wlxx-nucleo-bsp": "https://github.com/STMicroelectronics/stm32wlxx-nucleo-bsp.git",
    "b-wl5m-subg1-bsp": "https://github.com/STMicroelectronics/b-wl5m-subg1-bsp.git"
  },
  "linked_repo_refs": {},
  "commit_pr_scope": "linked_or_merged",
  "github_token_env": "GITHUB_TOKEN",
  "rate_limits": {
    "issues_sleep": 0.2,
    "comments_sleep": 0.1
  },
  "ingest_version": "v1.0"
}
