    "stm32h7rsxx-hal-driver": "https://github.com/STMicroelectronics/stm32h7rsxx-hal-driver.git",
    "cmsis_device_h7rs": "https://github.com/STMicroelectronics/cmsis_device_h7rs.git",
    "stm32h7s78-dk-bsp": "https://github.com/STMicroelectronics/stm32h7s78-dk-bsp.git"
  },
  "linked_repo_refs": {},
  "commit_pr_scope": "linked_or_merged",
  "github_token_env": "GITHUB_TOKEN",
  "rate_limits": {
    "issues_sleep": 0.2,
    "comments_sleep": 0.1
  },
  "ingest_version": "v1.0"
}
