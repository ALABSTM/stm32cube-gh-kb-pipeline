{
  "owner": "STMicroelectronics",
  "repos": [
    "STM32CubeF1",
    "stm32f1xx-hal-driver",
    "cmsis_device_f1",
    "stm32f1xx-nucleo-bsp",
    "stm32vldiscovery-bsp",
    "stm3210c-eval-bsp",
    "stm3210e-eval-bsp"
  ],
  "data_dir": "data",
  "repos_dir": "GitHub_repos",
  "auto_clone_missing_repos": true,
  "repo_clone_urls": {
    "stm32f1xx-hal-driver": "https://github.com/STMicroelectronics/stm32f1xx_hal_driver.git",
    "cmsis_device_f1": "https://github.com/STMicroelectronics/cmsis_device_f1.git",
    "stm32f1xx-nucleo-bsp": "https://github.com/STMicroelectronics/stm32f1xx-nucleo-bsp.git",
    "stm32vldiscovery-bsp": "https://github.com/STMicroelectronics/stm32vldiscovery-bsp.git",
    "stm3210c-eval-bsp": "https://github.com/STMicroelectronics/stm3210c-eval-bsp.git",
    "stm3210e-eval-bsp": "https://github.com/STMicroelectronics/stm3210e-eval-bsp.git"
  },
  "linked_repo_refs": {},
  "commit_pr_scope": "linked_or_merged",
  "github_token_env": "GITHUB_TOKEN",
  "rate_limits": {
    "issues_sleep": 0.2,
    "comments_sleep": 0.1
  },
  "ingest_version": "v1.0"
}
