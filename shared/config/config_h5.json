{
  "owner": "STMicroelectronics",
  "repos": [
    "STM32CubeH5",
    "stm32h5xx-hal-driver",
    "cmsis_device_h5",
    "stm32h5xx-nucleo-bsp",
    "stm32h573i-discovery-bsp",
    "stm32h5f5j-discovery-bsp"
  ],
  "data_dir": "data",
  "repos_dir": "GitHub_repos",
  "auto_clone_missing_repos": true,
  "repo_clone_urls": {
    "stm32h5xx-hal-driver": "https://github.com/STMicroelectronics/stm32h5xx_hal_driver.git",
    "cmsis_device_h5": "https://github.com/STMicroelectronics/cmsis_device_h5.git",
    "stm32h5xx-nucleo-bsp": "https://github.com/STMicroelectronics/stm32h5xx-nucleo-bsp.git",
    "stm32h573i-discovery-bsp": "https://github.com/STMicroelectronics/stm32h573i-discovery-bsp.git",
    "stm32h5f5j-discovery-bsp": "https://github.com/STMicroelectronics/stm32h5f5j-discovery-bsp.git"
  },
  "linked_repo_refs": {},
  "commit_pr_scope": "linked_or_merged",
  "github_token_env": "GITHUB_TOKEN",
  "rate_limits": {
    "issues_sleep": 0.2,
    "comments_sleep": 0.1
  },
  "ingest_version": "v1.0"
}
