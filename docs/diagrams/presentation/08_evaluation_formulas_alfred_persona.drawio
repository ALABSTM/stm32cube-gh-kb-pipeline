<mxfile host="app.diagrams.net" modified="2026-07-20T00:00:00.000Z" agent="copilot" version="24.0.0">
  <diagram id="evaluation-formulas" name="Formules Évaluation Alfred + Persona">
    <mxGraphModel dx="1600" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="&lt;b&gt;Évaluation Alfred &amp; Persona ST GitHub Analyzer — Métriques &amp; Formules&lt;/b&gt;" style="text;html=1;align=center;fontSize=18;fontColor=#03234B;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1300" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== BLOCK 1: ALFRED COHERENCE ===================== -->
        <mxCell id="b1-zone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;arcSize=3;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="800" height="400" as="geometry" />
        </mxCell>
        <mxCell id="b1-title" value="&lt;b&gt;① Score de Cohérence Alfred (validate_alfred_coherence.py)&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;fontColor=#c62828;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="75" y="88" width="600" height="25" as="geometry" />
        </mxCell>

        <!-- Formula block coherence -->
        <mxCell id="f1-formula" value="&lt;b&gt;Score final de cohérence :&lt;/b&gt;&#xa;&#xa;   C = clamp₀₁( base × (1 − penalty) )&#xa;&#xa;&lt;b&gt;Score de base :&lt;/b&gt;&#xa;&#xa;   base = ( α × L + β × S_sem ) / ( α + β )&#xa;&#xa;&lt;b&gt;Score lexical :&lt;/b&gt;&#xa;&#xa;   L = 0.7 × O_desc + 0.3 × O_ocr&#xa;&#xa;&lt;b&gt;Pénalité contradiction :&lt;/b&gt;&#xa;&#xa;   penalty = clamp₀₁( γ × P_contradiction )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f3;strokeColor=#c62828;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="90" y="120" width="430" height="270" as="geometry" />
        </mxCell>

        <!-- Variables table -->
        <mxCell id="f1-vars" value="&lt;b&gt;Variables&lt;/b&gt;&#xa;&#xa;C         = score cohérence final [0, 1]&#xa;L         = score lexical (TF-IDF overlap)&#xa;S_sem  = score sémantique (cosine similarity)&#xa;O_desc = overlap(description, contexte)&#xa;O_ocr   = overlap(OCR texte, contexte)&#xa;P_contradiction = proba. de contradiction NLI&#xa;α          = poids lexical (alpha_lexical)&#xa;β          = poids sémantique (beta_semantic)&#xa;γ          = facteur pénalité (gamma_contradiction)&#xa;&#xa;&lt;b&gt;Classes de fiabilité :&lt;/b&gt;&#xa;EXCELLENT  ≥ 0.75&#xa;BON              ≥ 0.55&#xa;ACCEPTABLE  ≥ 0.35&#xa;INSUFFISANT  &lt; 0.35" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f3;strokeColor=#c62828;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="545" y="120" width="290" height="270" as="geometry" />
        </mxCell>

        <!-- Results Alfred coherence -->
        <mxCell id="f1-results" value="&lt;b&gt;Résultats observés (alfred_coherence_summary.json)&lt;/b&gt;&#xa;&#xa;PDF figures:   242 analysées   |   58.3% faible cohérence   |   avg C = 0.18&#xa;Issue images: 200 analysées   |     1.5% faible cohérence   |   avg C = 0.50&#xa;&#xa;→ Les images issues GitHub sont bien enrichies (cohérence élevée)&#xa;→ Les figures PDF restent problématiques (contexte de page insuffisant)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffeef2;strokeColor=#c62828;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="405" width="745" height="65" as="geometry" />
        </mxCell>

        <!-- ===================== BLOCK 2: KB STRATEGY SCORE ===================== -->
        <mxCell id="b2-zone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;arcSize=3;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="80" width="900" height="400" as="geometry" />
        </mxCell>
        <mxCell id="b2-title" value="&lt;b&gt;② Score Stratégie KB (summarize_kb_strategy_results.py)&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;fontColor=#2e7d32;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="915" y="88" width="650" height="25" as="geometry" />
        </mxCell>

        <!-- Formula KB strategy -->
        <mxCell id="f2-formula" value="&lt;b&gt;Score pondéré stratégie KB :&lt;/b&gt;&#xa;&#xa;   S = 0.40 × R_top1&#xa;       + 0.20 × R_top3&#xa;       + 0.35 × R_answer&#xa;       − 0.15 × R_hallucination&#xa;       − 0.05 × (1 − B_latency)&#xa;&#xa;&lt;b&gt;Bonus latence (normalisé) :&lt;/b&gt;&#xa;&#xa;   B_latency = 1 − (latency − min_lat) / (max_lat − min_lat)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8f2;strokeColor=#2e7d32;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="930" y="120" width="420" height="270" as="geometry" />
        </mxCell>

        <!-- Variables KB -->
        <mxCell id="f2-vars" value="&lt;b&gt;Variables&lt;/b&gt;&#xa;&#xa;R_top1           = taux de doc pertinent en top-1&#xa;R_top3           = taux de doc pertinent en top-3&#xa;R_answer       = taux réponse correcte&#xa;R_hallucination = taux hallucination&#xa;B_latency        = bonus latence [0, 1]&#xa;                       (1 = rapide, 0 = lent)&#xa;&#xa;&lt;b&gt;Stratégies testées :&lt;/b&gt;&#xa;S0_CURRENT     Hybrid 0.55 / 20 / 12  (baseline)&#xa;S1_RECALL         Hybrid 0.45 / 30 / 20  (recall max)&#xa;S2_BALANCED   Hybrid 0.55 / 25 / 12  (compromis)&#xa;S3_PRECISION    Hybrid 0.65 / 15 / 8    (précision max)&#xa;S4_SEMANTIC    Hybrid 0.50 / 30 / 8    (sémantique)&#xa;S5_KEYWORD     Hybrid 0.60 / 15 / 20  (exact tokens)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8f2;strokeColor=#2e7d32;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1370" y="120" width="390" height="270" as="geometry" />
        </mxCell>

        <!-- Results KB -->
        <mxCell id="f2-results" value="&lt;b&gt;Objectif : sélectionner la stratégie maximisant S → meilleure configuration KB pour la persona&lt;/b&gt;&#xa;Poids justifiés : R_answer dominant (35%) car la réponse finale compte le plus | R_top1 (40%) car le premier doc oriente la réponse | Hallucination pénalisée (−15%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7ec;strokeColor=#2e7d32;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="930" y="405" width="830" height="65" as="geometry" />
        </mxCell>

        <!-- ===================== BLOCK 3: QUALITY INDEX ===================== -->
        <mxCell id="b3-zone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;arcSize=3;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="800" height="350" as="geometry" />
        </mxCell>
        <mxCell id="b3-title" value="&lt;b&gt;③ Quality Index (QI) — Évaluation offline vs online persona&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;fontColor=#1565c0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="75" y="518" width="650" height="25" as="geometry" />
        </mxCell>

        <!-- QI formulas -->
        <mxCell id="f3-formula" value="&lt;b&gt;Normalisation score offline (0–7 → 0–100) :&lt;/b&gt;&#xa;&#xa;   QI_offline = ( total_0_to_7 / 7 ) × 100&#xa;&#xa;&lt;b&gt;Score online (ST Quality Index fourni) :&lt;/b&gt;&#xa;&#xa;   QI_online ∈ [0, 100]&#xa;   (score fourni par la plateforme ST ChatGPT)&#xa;&#xa;&lt;b&gt;Delta comparaison (points de % ) :&lt;/b&gt;&#xa;&#xa;   Δ = QI_online − QI_offline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4fd;strokeColor=#1565c0;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="90" y="550" width="430" height="250" as="geometry" />
        </mxCell>

        <!-- QI criteria -->
        <mxCell id="f3-crit" value="&lt;b&gt;Critères d'évaluation offline (7 points max) :&lt;/b&gt;&#xa;&#xa;1. Pertinence du doc source récupéré              /1&#xa;2. Doc pertinent présent en top-3                   /1&#xa;3. Réponse factuellement correcte                   /2&#xa;4. Absence d'hallucination                               /1&#xa;5. Couverture de la question posée                /1&#xa;6. Qualité formelle de la réponse                    /1&#xa;&#xa;→ Total: /7 → normalisé /100 via QI_offline&#xa;&#xa;&lt;b&gt;Interprétation Δ :&lt;/b&gt;&#xa;Δ &gt; 0   → persona meilleure que scoring manuel&#xa;Δ &lt; 0   → persona sous-performe vs. manuel&#xa;Δ ≈ 0   → cohérence scoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4fd;strokeColor=#1565c0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="545" y="550" width="290" height="295" as="geometry" />
        </mxCell>

        <!-- ===================== BLOCK 4: PERSONA COMPARISON ===================== -->
        <mxCell id="b4-zone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#4527a0;arcSize=3;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="510" width="900" height="350" as="geometry" />
        </mxCell>
        <mxCell id="b4-title" value="&lt;b&gt;④ Comparaison Persona ST GitHub Analyzer vs Alfred direct&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;fontColor=#4527a0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="915" y="518" width="750" height="25" as="geometry" />
        </mxCell>

        <!-- Comparison table -->
        <mxCell id="f4-table" value="&lt;table border='1' cellpadding='6' style='border-collapse:collapse;font-size:11px;width:100%;'&gt;&#xa;&lt;tr style='background:#4527a0;color:white;'&gt;&#xa;  &lt;th&gt;Critère&lt;/th&gt;&#xa;  &lt;th&gt;Alfred Direct&lt;/th&gt;&#xa;  &lt;th&gt;Persona KB + Alfred Fallback&lt;/th&gt;&#xa;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Source de réponse&lt;/b&gt;&lt;/td&gt;&lt;td&gt;LLM générique (chat)&lt;/td&gt;&lt;td&gt;KB STM32Cube indexée + LLM&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr style='background:#f3e5f5;'&gt;&lt;td&gt;&lt;b&gt;Ancrage factuel&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Mémoire modèle seule&lt;/td&gt;&lt;td&gt;Issues + Resolver + Diag Cards&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Couverture images&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Si URL fournie&lt;/td&gt;&lt;td&gt;Pre-enrichi via Alfred Vision&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr style='background:#f3e5f5;'&gt;&lt;td&gt;&lt;b&gt;Risque hallucination&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Élevé (pas de RAG)&lt;/td&gt;&lt;td&gt;Réduit (RAG KB structuré)&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Latence&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Faible&lt;/td&gt;&lt;td&gt;Modérée (KB lookup + LLM)&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr style='background:#f3e5f5;'&gt;&lt;td&gt;&lt;b&gt;Spécificité STM32&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Générale&lt;/td&gt;&lt;td&gt;Très élevée (47 repos indexés)&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Fallback Alfred&lt;/b&gt;&lt;/td&gt;&lt;td&gt;N/A&lt;/td&gt;&lt;td&gt;Si KB no match → Alfred call&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];strokeColor=#4527a0;fillColor=#f9f4ff;rounded=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="550" width="840" height="240" as="geometry" />
        </mxCell>

        <!-- ===================== BLOCK 5: PIPELINE SCORES SUMMARY ===================== -->
        <mxCell id="b5-zone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#e65100;arcSize=3;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="890" width="1740" height="200" as="geometry" />
        </mxCell>
        <mxCell id="b5-title" value="&lt;b&gt;⑤ Synthèse des métriques pipeline — Vue d'ensemble&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;fontColor=#e65100;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="75" y="898" width="700" height="25" as="geometry" />
        </mxCell>

        <!-- Summary metrics boxes -->
        <mxCell id="m1" value="&lt;b&gt;Cohérence Alfred&lt;/b&gt;&#xa;Issue images: C ≈ 0.50&#xa;PDF figures:   C ≈ 0.18&#xa;Seuil low: C &lt; 0.35&#xa;&#xa;→ Améliorer contexte PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="90" y="930" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;Stratégie KB&lt;/b&gt;&#xa;Score S ∈ [0, 1]&#xa;Pondéré: top1 40%&#xa;              answer 35%&#xa;              top3 20%&#xa;— hallucination 15%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="930" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;Quality Index&lt;/b&gt;&#xa;Offline: /7 → ×100/7&#xa;Online: ST QI [0, 100]&#xa;Δ = online − offline&#xa;&#xa;Compare 2 persona runs&#xa;vs scoring manuel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="610" y="930" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="&lt;b&gt;Schémas / Validité&lt;/b&gt;&#xa;validate_schemas.py&#xa;porte qualité blocante&#xa;&#xa;is_valid = True requis&#xa;0 placeholders non résolus&#xa;Résumé summary_*.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="870" y="930" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="&lt;b&gt;Couverture séries&lt;/b&gt;&#xa;Repos actifs: G4 L0 L1 L4&#xa;L5 N6 U0 U3 WB WBA WL3&#xa;&#xa;Issues + files + drivers&#xa;+ subrepos tous couverts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#e65100;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1130" y="930" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="&lt;b&gt;Outils d'évaluation&lt;/b&gt;&#xa;test_stats_issues_v2.py&#xa;test_tfidf_search_*.py&#xa;run_persona_kb_eval.py&#xa;compare_offline_online.py&#xa;validate_alfred_coherence.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#283593;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1390" y="930" width="230" height="140" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
