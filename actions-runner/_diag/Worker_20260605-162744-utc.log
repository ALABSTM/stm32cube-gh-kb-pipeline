rds_*.json 1>/dev/null 2>&1; then\n    python $UPLOADER \\\n      --kb 793 \\\n      --operation add \\\n      --datasource-id ${{DS_DIAGNOSTIC[$s]}} \\\n      --files ${{BASE}}/diagnostic_cards_json/st_ready_diagnostic_cards_stm32cube${{s}}.json \\\n      --json-split-size 1000 \\\n      --remote-user \"$ST_REMOTE_USER\"\n  fi\ndone\n', needs.pipeline.outputs.series)"
