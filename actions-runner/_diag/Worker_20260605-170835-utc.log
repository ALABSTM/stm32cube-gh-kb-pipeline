              "expr": "format('$series = \"{0}\" -split \",\"\n$DS_ISSUES = @{{ f4=28099; h5=28158; h7=19896; u5=28167; wl=28171 }}\n$DS_FILES = @{{ f4=28103; h5=28163; h7=21824; u5=28168; wl=28172 }}\n$DS_RESOLVER = @{{ f4=28118; h5=28164; h7=20403; u5=28244; wl=28245 }}\n$DS_DIAGNOSTIC = @{{ f4=28122; h5=28165; h7=23768; u5=28170; wl=28173 }}\n\n$uploader = \"pipeline_Automation/upload/Add_Data_Source_Files.py\"\n\nforeach ($s in $series) {{\n  $base = \"st-ready/stm32cube$s\"\n  if (-not $DS_ISSUES.ContainsKey($s)) {{\n    Write-Host \"=== Skipping $($s.ToUpper()) (no datasource IDs) ===\"\n    continue\n  }}\n  Write-Host \"=== Uploading $($s.ToUpper()) ===\"\n\n  # Issues\n  $f = \"$base/issues_json/st_ready_issues_stm32cube$s.json\"\n  if (Test-Path $f) {{\n    python $uploader --kb 793 --operation add --datasource-id $($DS_ISSUES[$s]) --files $f --json-split-size 1000 --remote-user $env:ST_REMOTE_USER\n  }}\n  # Files\n  $f = \"$base/files_json/st_ready_files_stm32cube$s.json\"\n  if (Test-Path $f) {{\n    python $uploader --kb 793 --operation add --datasource-id $($DS_FILES[$s]) --files $f --json-split-size 1000 --remote-user $env:ST_REMOTE_USER\n  }}\n  # Resolver Cases\n  $f = \"$base/resolver_cases_json/st_ready_resolver_cases_stm32cube$s.json\"\n  if (Test-Path $f) {{\n    python $uploader --kb 793 --operation add --datasource-id $($DS_RESOLVER[$s]) --files $f --json-split-size 1000 --remote-user $env:ST_REMOTE_USER\n  }}\n  # Diagnostic Cards\n  $f = \"$base/diagnostic_cards_json/st_ready_diagnostic_cards_stm32cube$s.json\"\n  if (Test-Path $f) {{\n    python $uploader --kb 793 --operation add --datasource-id $($DS_DIAGNOSTIC[$s]) --files $f --json-split-size 1000 --remote-user $env:ST_REMOTE_USER\n  }}\n}}\n', needs.pipeline.outputs.series)"
